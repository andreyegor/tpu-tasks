-- Терминал 1
-----------------------------------------------------------------------------------
-- Уровень изоляции READ UNCOMMITED
-- Это самый слабый уровень изоляции, когда транзакция может видеть результаты 
-- других транзакций, даже если они ещё не закоммичены.
-- PostgreSQL игнорирует READ UNCOMMITTED и применяет READ COMMITTED
-----------------------------------------------------------------------------------
BEGIN TRANSACTION ISOLATION LEVEL READ UNCOMMITTED;  -- 1
INSERT INTO -- 2
  venues (venue_name, venue_location)
VALUES
  ('Объект 1', 'Адрес 1'),
  ('Объект 2', 'Адрес 2'),
  ('Объект 3', 'Адрес 3');
ROLLBACK; -- 5
-----------------------------------------------------------------------------------
-- Уровень изоляции READ COMMITED
-- На этом уровне транзакция может читать только те изменения в других параллельных 
-- транзакциях, которые уже были закоммичены.
-----------------------------------------------------------------------------------
BEGIN ISOLATION LEVEL READ COMMITTED; -- 1
INSERT INTO -- 2
  venues (venue_name, venue_location)
VALUES
  ('Объект 1', 'Адрес 1'),
  ('Объект 2', 'Адрес 2'),
  ('Объект 3', 'Адрес 3');
COMMIT; -- 5
-----------------------------------------------------------------------------------
-- Уровень изоляции REPEATABLE READ
-- Этот уровень означает, что пока транзакция не завершится, никто параллельно не 
-- может изменять или удалять строки, которые транзакция уже прочитала.
-----------------------------------------------------------------------------------
BEGIN ISOLATION LEVEL REPEATABLE READ; -- 1
SELECT * FROM venues; -- 2
ROLLBACK; -- 5