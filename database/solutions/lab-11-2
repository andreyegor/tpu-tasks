-- Терминал 2
-----------------------------------------------------------------------------------
-- Уровень изоляции READ COMMITED
-- На этом уровне транзакция может читать только те изменения в других параллельных 
-- транзакциях, которые уже были закоммичены.
-----------------------------------------------------------------------------------
BEGIN ISOLATION LEVEL READ COMMITTED; -- 3
SELECT * FROM venues; -- 4
SELECT * FROM venues; -- 6
ROLLBACK; -- 7
-----------------------------------------------------------------------------------
-- Уровень изоляции REPEATABLE READ
-- Этот уровень означает, что пока транзакция не завершится, никто параллельно не 
-- может изменять или удалять строки, которые транзакция уже прочитала.
-----------------------------------------------------------------------------------
BEGIN ISOLATION LEVEL REPEATABLE READ; -- 3
DELETE FROM venues; -- 4
COMMIT; -- 6